{
  "compilerOptions": {
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2022"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "dev/localApiPlugin.ts",
    "dev/localDb.ts",
    "tailwind.config.ts",
    "src/domain/scoring.ts",
    "src/domain/resultSnapshot.ts",
    "src/domain/aiContracts.ts",
    "src/domain/matchPriority.ts",
    "src/data/influencers.ts",
    "src/data/options.ts",
    "src/app/types.ts"
  ]
}
